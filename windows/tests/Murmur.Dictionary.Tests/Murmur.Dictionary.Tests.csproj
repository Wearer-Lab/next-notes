<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- CA1062 (validate public args) is noise in a test project. -->
    <NoWarn>$(NoWarn);CA1062</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Murmur.Dictionary\Murmur.Dictionary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The single shared contract, referenced by link from the repo root rather than
         copied. A copy would drift, and drift is the exact failure this file prevents. -->
    <None Include="..\..\..\shared\dictionary-test-vectors.json"
          Link="dictionary-test-vectors.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
