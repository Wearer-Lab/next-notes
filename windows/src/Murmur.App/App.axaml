<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Murmur.App.App"
             RequestedThemeVariant="Default">
  <!-- Default, not a fixed variant: the app follows the system, which is what picks
       between the silver face and the black face. -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <!-- Secondary interface. The main window is the app; this is for status and reaching
       Murmur while working in something else. Avalonia's TrayIcon maps to the Windows
       notification area and needs no extra package. -->
  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/tray.ico" ToolTipText="Murmur — hold the push-to-talk key to dictate">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show Murmur" Click="OnTrayShow" />
            <NativeMenuItem Header="Settings…" Click="OnTraySettings" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Quit" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
